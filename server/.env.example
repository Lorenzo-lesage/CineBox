APP_NAME=CineBox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Hosts are Docker Compose service names
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=cinebox
DB_USERNAME=cinebox_user
DB_PASSWORD=cinebox_pass

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=cinebox

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@cinebox.test"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=cinebox
REVERB_APP_KEY=cinebox-key
REVERB_APP_SECRET=cinebox-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# Get a read access token at https://www.themoviedb.org/settings/api
TMDB_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
